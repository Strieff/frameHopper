<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane maxHeight="600.0" maxWidth="800.0" prefHeight="900.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.FrameHopper.app.ui.controller.ImportChartController">
    <top>
        <ToolBar prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <Button onAction="#handleSave">
                <graphic>
                    <ImageView fx:id="saveButtonIcon" fitHeight="32.0" fitWidth="32.0" />
                </graphic>
                <VBox.margin>
                    <Insets bottom="20.0" top="5.0" />
                </VBox.margin>
            </Button>
            <Button onAction="#close">
                <graphic>
                    <ImageView fx:id="closeButtonIcon" fitHeight="32.0" fitWidth="32.0" />
                </graphic>
                <VBox.margin>
                    <Insets bottom="20.0" />
                </VBox.margin>
            </Button>
        </ToolBar>
    </top>

    <center>
        <VBox fx:id="saveArea">
            <StackPane fx:id="chartPane" minHeight="550.0" prefHeight="650.0">
                <BarChart>
                    <xAxis>
                        <CategoryAxis side="BOTTOM" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="yAxis" side="LEFT" />
                    </yAxis>
                </BarChart>
                <LineChart minHeight="550.0">
                    <xAxis>
                        <CategoryAxis side="BOTTOM" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="yAxisLine" side="LEFT" />
                    </yAxis>
                </LineChart>
            </StackPane>
            <HBox fx:id="legendContainer" alignment="TOP_CENTER" fillHeight="false" maxHeight="50.0" minHeight="50.0" prefHeight="50.0" prefWidth="700.0">
                <HBox prefHeight="100.0" prefWidth="200.0">
                    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="GREEN" height="41.0" stroke="BLACK" strokeType="INSIDE" width="47.0">
                        <HBox.margin>
                            <Insets left="10.0" top="5.0" />
                        </HBox.margin>
                    </Rectangle>
                    <Label prefHeight="50.0" prefWidth="140.0" text="VALUE">
                        <HBox.margin>
                            <Insets left="5.0" />
                        </HBox.margin>
                    </Label>
                </HBox>

                <HBox prefHeight="100.0" prefWidth="200.0">
                    <Rectangle arcHeight="5.0" arcWidth="5.0" fill="RED" height="41.0" stroke="BLACK" strokeType="INSIDE" width="47.0">
                        <HBox.margin>
                            <Insets left="10.0" top="5.0" />
                        </HBox.margin>
                    </Rectangle>
                    <Label prefHeight="50.0" prefWidth="140.0" text="VALUE">
                        <HBox.margin>
                            <Insets left="5.0" />
                        </HBox.margin>
                    </Label>
                </HBox>

                <HBox prefHeight="100.0" prefWidth="200.0">
                    <Line startX="-100.0" stroke="#ff8d01" strokeWidth="5.0">
                        <HBox.margin>
                            <Insets top="22.0" />
                        </HBox.margin></Line>
                    <Label prefHeight="50.0" prefWidth="140.0" text="MEAN">
                        <HBox.margin>
                            <Insets left="5.0" />
                        </HBox.margin>
                    </Label>
                </HBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
